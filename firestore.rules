rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isPositiveMoney(value) {
      return value is int && value > 0;
    }

    function isNonNegativeMoney(value) {
      return value is int && value >= 0;
    }

    // User root document and subcollections are isolated per-user
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /transactions/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && (request.resource.data == null // Delete
              || (request.resource.data.type in ['income', 'expense', 'transfer_out', 'transfer_in', 'INCOME', 'EXPENSE', 'TRANSFER_OUT', 'TRANSFER_IN']
                  && isPositiveMoney(request.resource.data.amount)
                  && request.resource.data.walletId is string));
      }

      match /wallets/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && (request.resource.data == null // Delete
              || (request.resource.data.name is string
                  && request.resource.data.balance is int));
      }

      match /budgets/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && (request.resource.data == null // Delete
              || (request.resource.data.categoryId is string
                  && request.resource.data.spentAmount is int));
      }

      match /categories/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid);
      }

      match /goals/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid);
      }

      match /reminders/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid);
      }

      match /notifications/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid);
      }

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
