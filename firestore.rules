rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User root document and subcollections are isolated per-user
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
