rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isPositiveMoney(value) {
      return value is int && value > 0;
    }

    function isNonNegativeMoney(value) {
      return value is int && value >= 0;
    }

    function walletPath(uid, walletId) {
      return /databases/$(database)/documents/users/$(uid)/wallets/$(walletId);
    }

    function dealPath(uid, dealId) {
      return /databases/$(database)/documents/users/$(uid)/deals/$(dealId);
    }

    function transactionDelta(data) {
      return data.type in ['income', 'transfer_in', 'INCOME', 'TRANSFER_IN']
        ? data.amount
        : 0 - data.amount;
    }

    function walletMovesBy(uid, walletId, delta) {
      return exists(walletPath(uid, walletId))
        && getAfter(walletPath(uid, walletId)).data.balance
          == get(walletPath(uid, walletId)).data.balance + delta;
    }

    function isDealLedgerTransaction(data) {
      return ('dealId' in data)
        && data.dealId is string
        && data.dealId.size() > 0
        && ('dealFlowType' in data)
        && data.dealFlowType != null;
    }

    function isDealSettlement(data) {
      return data.walletId == 'DEAL_SETTLEMENT'
        && data.type in ['expense', 'EXPENSE']
        && data.dealId is string
        && data.dealId.size() > 0
        && data.dealFlowType in ['capital_loss', 'CAPITAL_LOSS'];
    }

    function validTransaction(data) {
      return data.keys().hasOnly([
          'type', 'amount', 'categoryId', 'walletId', 'relatedWalletId',
          'dealId', 'dealFlowType',
          'goalId', 'goalFlowType',
          'debtId', 'debtPrincipalAmount', 'debtInterestAmount',
          'note', 'receiptImageUrl', 'date', 'createdAt', 'updatedAt'
        ])
        && data.type in [
          'income', 'expense', 'transfer_out', 'transfer_in',
          'INCOME', 'EXPENSE', 'TRANSFER_OUT', 'TRANSFER_IN'
        ]
        && isPositiveMoney(data.amount)
        && data.walletId is string
        && data.walletId.size() > 0
        && data.date is timestamp
        && (!('dealId' in data) || data.dealId == null || data.dealId is string)
        && (!('dealFlowType' in data) || data.dealFlowType == null || data.dealFlowType in [
          'outlay_capital', 'principal_recovery', 'capital_gain', 'capital_loss',
          'OUTLAY_CAPITAL', 'PRINCIPAL_RECOVERY', 'CAPITAL_GAIN', 'CAPITAL_LOSS'
        ])
        && (!('goalId' in data) || data.goalId == null || data.goalId is string)
        && (!('goalFlowType' in data) || data.goalFlowType == null || data.goalFlowType in [
          'allocation', 'release', 'ALLOCATION', 'RELEASE'
        ])
        && (
          (!('goalId' in data) || data.goalId == null)
            ? (!('goalFlowType' in data) || data.goalFlowType == null)
            : (
              ('goalFlowType' in data)
              && data.goalFlowType != null
              && (
                (data.goalFlowType in ['allocation', 'ALLOCATION'] && data.type in ['expense', 'EXPENSE'])
                || (data.goalFlowType in ['release', 'RELEASE'] && data.type in ['income', 'INCOME'])
              )
            )
        )
        && (!('debtId' in data) || data.debtId == null || data.debtId is string)
        && (!('debtPrincipalAmount' in data) || data.debtPrincipalAmount == null || isNonNegativeMoney(data.debtPrincipalAmount))
        && (!('debtInterestAmount' in data) || data.debtInterestAmount == null || isNonNegativeMoney(data.debtInterestAmount))
        && (
          (
            !('debtId' in data)
            || data.debtId == null
          )
          ? (
            (!('debtPrincipalAmount' in data) || data.debtPrincipalAmount == null)
            && (!('debtInterestAmount' in data) || data.debtInterestAmount == null)
          )
          : (
            data.type in ['expense', 'EXPENSE']
            && ('debtPrincipalAmount' in data)
            && ('debtInterestAmount' in data)
            && data.debtPrincipalAmount is int
            && data.debtInterestAmount is int
            && data.debtPrincipalAmount + data.debtInterestAmount == data.amount
          )
        );
    }

    function validBudget(data) {
      return data.keys().hasOnly([
          'categoryId', 'periodKey', 'periodStart', 'periodEndExclusive',
          'periodBasis', 'month', 'limitAmount', 'spentAmount',
          'notified80', 'notified100'
        ])
        && (!('categoryId' in data) || (data.categoryId is string && data.categoryId.size() > 0))
        && (!('periodKey' in data) || (data.periodKey is string && data.periodKey.size() > 0))
        && (!('periodStart' in data) || data.periodStart == null || data.periodStart is int || data.periodStart is timestamp)
        && (!('periodEndExclusive' in data) || data.periodEndExclusive == null || data.periodEndExclusive is int || data.periodEndExclusive is timestamp)
        && (!('periodBasis' in data) || data.periodBasis == null || data.periodBasis in ['CALENDAR_MONTH', 'SALARY_CYCLE'])
        && (!('month' in data) || data.month == null || data.month is string)
        && (!('limitAmount' in data) || isNonNegativeMoney(data.limitAmount))
        && (!('spentAmount' in data) || isNonNegativeMoney(data.spentAmount))
        && (!('notified80' in data) || data.notified80 is bool)
        && (!('notified100' in data) || data.notified100 is bool);
    }

    function validDeal(data) {
      return data.keys().hasOnly([
          'title', 'description', 'category', 'targetAmount',
          'totalCapitalOutlay', 'totalRecovered', 'netProfitLoss',
          'status', 'startDate', 'endDate', 'createdAt', 'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && data.description is string
        && data.description.size() <= 2000
        && data.category in ['investment', 'lending', 'INVESTMENT', 'LENDING']
        && isNonNegativeMoney(data.targetAmount)
        && isNonNegativeMoney(data.totalCapitalOutlay)
        && isNonNegativeMoney(data.totalRecovered)
        && data.netProfitLoss is int
        && data.status in ['active', 'completed', 'cancelled', 'ACTIVE', 'COMPLETED', 'CANCELLED']
        && data.startDate is timestamp
        && (data.endDate == null || data.endDate is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validSalaryCyclePreference(data) {
      return data.keys().hasOnly([
          'enabled', 'paydayRuleType', 'paydayDay', 'salaryWalletId',
          'savingsWalletId', 'expectedSalary', 'rolloverRule',
          'budgetPeriodBasis', 'financeTimeZone', 'updatedAt'
        ])
        && data.enabled is bool
        && data.paydayRuleType in ['DAY_OF_MONTH', 'FIRST_DAY_OF_MONTH', 'LAST_DAY_OF_MONTH']
        && data.paydayDay is int
        && data.paydayDay >= 1
        && data.paydayDay <= 31
        && data.rolloverRule in ['KEEP_IN_WALLET', 'MOVE_TO_SAVINGS', 'ASK_EACH_CYCLE']
        && data.budgetPeriodBasis in ['CALENDAR_MONTH', 'SALARY_CYCLE']
        && data.financeTimeZone is string
        && data.financeTimeZone.size() > 0
        && data.financeTimeZone.size() <= 64
        && (!('salaryWalletId' in data) || data.salaryWalletId == null || data.salaryWalletId is string)
        && (!('savingsWalletId' in data) || data.savingsWalletId == null || data.savingsWalletId is string)
        && (!('expectedSalary' in data) || data.expectedSalary == null || isPositiveMoney(data.expectedSalary))
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function validSavingSpinConfig(data) {
      return data.keys().hasOnly([
          'enabled', 'showOnHome', 'minAmount', 'maxAmount', 'stepAmount',
          'slotCount', 'frequency', 'selectedWeekdays', 'weeklyDay',
          'reminderEnabled', 'reminderHour', 'reminderMinute', 'snoozeEnabled',
          'allowSkip', 'defaultDestinationId', 'createdAt', 'updatedAt'
        ])
        && data.enabled is bool
        && data.showOnHome is bool
        && isPositiveMoney(data.minAmount)
        && isPositiveMoney(data.maxAmount)
        && data.maxAmount >= data.minAmount
        && data.maxAmount <= 999999999999999
        && data.stepAmount in [5000, 10000]
        && data.minAmount % data.stepAmount == 0
        && data.maxAmount % data.stepAmount == 0
        && data.slotCount in [6, 8, 10, 12]
        && data.frequency in ['DAILY', 'SELECTED_WEEKDAYS', 'WEEKLY', 'SALARY_CYCLE']
        && data.selectedWeekdays is list
        && data.weeklyDay is int && data.weeklyDay >= 1 && data.weeklyDay <= 7
        && data.reminderEnabled is bool
        && data.reminderHour is int && data.reminderHour >= 0 && data.reminderHour <= 23
        && data.reminderMinute is int && data.reminderMinute >= 0 && data.reminderMinute <= 59
        && data.snoozeEnabled is bool
        && data.allowSkip is bool
        && (data.defaultDestinationId == null || data.defaultDestinationId is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validSavingDestination(data) {
      return data.keys().hasOnly([
          'name', 'method', 'linkedWalletId', 'institutionId', 'accountHint',
          'enabled', 'icon', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.method in ['CASH', 'BANK_TRANSFER']
        && (data.linkedWalletId == null || data.linkedWalletId is string)
        && (data.institutionId == null || data.institutionId is string)
        && (data.accountHint == null || (data.accountHint is string && data.accountHint.size() <= 40))
        && (!('icon' in data) || data.icon == null || (data.icon is string && data.icon.size() <= 80))
        && data.enabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validSavingSpinSession(data) {
      return data.keys().hasOnly([
          'scheduleKey', 'wheelValues', 'selectedIndex', 'selectedAmount', 'status',
          'destinationId', 'method', 'spunAt', 'completedAt', 'skippedAt',
          'snoozedUntil', 'transactionId', 'createdAt', 'updatedAt'
        ])
        && data.scheduleKey is string && data.scheduleKey.size() > 0
        && data.wheelValues is list && data.wheelValues.size() in [6, 8, 10, 12]
        && (data.selectedIndex == null || data.selectedIndex is int)
        && (data.selectedAmount == null || isPositiveMoney(data.selectedAmount))
        && data.status in ['READY', 'SPUN_PENDING', 'COMPLETED', 'SNOOZED', 'SKIPPED']
        && (data.destinationId == null || data.destinationId is string)
        && (data.method == null || data.method in ['CASH', 'BANK_TRANSFER'])
        && (data.spunAt == null || data.spunAt is timestamp)
        && (data.completedAt == null || data.completedAt is timestamp)
        && (data.skippedAt == null || data.skippedAt is timestamp)
        && (data.snoozedUntil == null || data.snoozedUntil is timestamp)
        && (!('transactionId' in data) || data.transactionId == null || (data.transactionId is string && data.transactionId.size() > 0))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validSavingSpinTransition(before, after) {
      return before.status == after.status
        || (before.status == 'READY' && after.status in ['SPUN_PENDING', 'SKIPPED'])
        || (before.status == 'SNOOZED' && after.status in ['SPUN_PENDING', 'COMPLETED', 'SNOOZED', 'SKIPPED'])
        || (before.status == 'SPUN_PENDING' && after.status in ['COMPLETED', 'SNOOZED', 'SKIPPED']);
    }

    // Root user profile document
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);

      // Subcollection: Transactions
      match /transactions/{docId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validTransaction(request.resource.data)
          && (
            isDealSettlement(request.resource.data)
            || walletMovesBy(
              uid,
              request.resource.data.walletId,
              transactionDelta(request.resource.data)
            )
          );
        allow update: if isOwner(uid)
          && validTransaction(request.resource.data)
          && (
            (
              isDealSettlement(resource.data)
              && isDealSettlement(request.resource.data)
              && request.resource.data.amount == resource.data.amount
              && request.resource.data.dealId == resource.data.dealId
              && request.resource.data.dealFlowType == resource.data.dealFlowType
            )
            ||
            (
              !isDealSettlement(resource.data)
              && !isDealSettlement(request.resource.data)
              && (
                (resource.data.walletId == request.resource.data.walletId
                  && walletMovesBy(
                    uid,
                    request.resource.data.walletId,
                    transactionDelta(request.resource.data) - transactionDelta(resource.data)
                  ))
                ||
                (resource.data.walletId != request.resource.data.walletId
                  && walletMovesBy(uid, resource.data.walletId, 0 - transactionDelta(resource.data))
                  && walletMovesBy(
                    uid,
                    request.resource.data.walletId,
                    transactionDelta(request.resource.data)
                  ))
              )
            )
          );
        allow delete: if isOwner(uid)
          && (
            isDealSettlement(resource.data)
            || (
              isDealLedgerTransaction(resource.data)
              && !existsAfter(dealPath(uid, resource.data.dealId))
            )
            || walletMovesBy(uid, resource.data.walletId, 0 - transactionDelta(resource.data))
          );
      }

      // Subcollection: Wallets
      match /wallets/{docId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'name', 'type', 'balance', 'color', 'isDefault', 'createdAt', 'status', 'archivedAt', 'lastTransactionId'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.balance is int
          && request.resource.data.type in ['cash', 'bank', 'ewallet', 'card', 'investment', 'other']
          && (!('status' in request.resource.data) || request.resource.data.status in ['active', 'archived'])
          && (!('archivedAt' in request.resource.data) || request.resource.data.archivedAt is timestamp);

        allow update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'name', 'type', 'balance', 'color', 'isDefault', 'createdAt', 'status', 'archivedAt', 'lastTransactionId'
          ])
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() > 0))
          && (!('balance' in request.resource.data) || request.resource.data.balance is int)
          && (!('type' in request.resource.data) || request.resource.data.type in ['cash', 'bank', 'ewallet', 'card', 'investment', 'other'])
          && (!('status' in request.resource.data) || request.resource.data.status in ['active', 'archived'])
          && (!('archivedAt' in request.resource.data) || request.resource.data.archivedAt is timestamp)
          && (
            request.resource.data.balance == resource.data.balance
            || (
              'lastTransactionId' in request.resource.data
              && request.resource.data.lastTransactionId is string
              && request.resource.data.lastTransactionId.size() > 0
            )
          );
      }

      // Subcollection: Budgets
      // spentAmount is server-owned. Clients can create a budget with an initial non-negative
      // spentAmount, but cannot mutate it afterwards; Cloud Functions reconcile it from ledger data.
      match /budgets/{docId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && validBudget(request.resource.data);
        allow update: if isOwner(uid)
          && validBudget(request.resource.data)
          && request.resource.data.spentAmount == resource.data.spentAmount;
      }

      // Subcollection: Categories
      match /categories/{docId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0;
      }

      // Subcollection: Financial Goals
      match /goals/{docId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid)
          && (!('savedAmount' in resource.data) || resource.data.savedAmount <= 0);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0;
      }

      // Subcollection: Reminders
      match /reminders/{docId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.categoryId is string
          && request.resource.data.walletId is string;
      }

      // Subcollection: Notifications
      match /notifications/{docId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.title is string;
      }

      // User financial preferences
      match /financialPreferences/{preferenceId} {
        allow read: if isOwner(uid) && preferenceId == 'salaryCycle';
        allow create, update: if isOwner(uid)
          && preferenceId == 'salaryCycle'
          && validSalaryCyclePreference(request.resource.data);
        allow delete: if isOwner(uid) && preferenceId == 'salaryCycle';
      }

      // Subcollection: Salary Rollovers
      match /salaryRollovers/{docId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['cycleKey', 'processedAt'])
          && request.resource.data.cycleKey is string
          && request.resource.data.processedAt is timestamp;
        allow update: if false;
        allow delete: if false;
      }

      match /savingSpinConfigs/{configId} {
        allow read: if isOwner(uid) && configId == 'default';
        allow create, update: if isOwner(uid)
          && configId == 'default'
          && validSavingSpinConfig(request.resource.data);
        allow delete: if isOwner(uid) && configId == 'default';
      }

      match /savingSpinDestinations/{destinationId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validSavingDestination(request.resource.data)
          && (!('accountHint' in request.resource.data)
            || request.resource.data.accountHint == null
            || !request.resource.data.accountHint.matches('.*[0-9]{7,}.*'));
      }

      match /savingSpinSessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validSavingSpinSession(request.resource.data)
          && request.resource.data.status == 'READY'
          && request.resource.data.selectedIndex == null
          && request.resource.data.selectedAmount == null
          && (!('transactionId' in request.resource.data) || request.resource.data.transactionId == null);
        allow update: if isOwner(uid)
          && resource.data.status != 'COMPLETED'
          && validSavingSpinSession(request.resource.data)
          && request.resource.data.scheduleKey == resource.data.scheduleKey
          && request.resource.data.wheelValues == resource.data.wheelValues
          && request.resource.data.createdAt == resource.data.createdAt
          && validSavingSpinTransition(resource.data, request.resource.data)
          && (resource.data.selectedAmount == null
            || (request.resource.data.selectedAmount == resource.data.selectedAmount
              && request.resource.data.selectedIndex == resource.data.selectedIndex))
          && (
            request.resource.data.status != 'COMPLETED'
            || (
              request.resource.data.destinationId is string
              && request.resource.data.destinationId.size() > 0
              && request.resource.data.method in ['CASH', 'BANK_TRANSFER']
              && request.resource.data.completedAt is timestamp
              && (
                request.resource.data.method != 'BANK_TRANSFER'
                || (
                  request.resource.data.transactionId is string
                  && request.resource.data.transactionId.size() > 0
                )
              )
            )
          );
        allow delete: if false;
      }

      // Subcollection: Deals / Investments / Lending
      match /deals/{dealId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validDeal(request.resource.data);
      }

      // Subcollection: Debts & Debt Payments
      match /debts/{docId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid)
          && (!('remainingBalance' in resource.data) || resource.data.remainingBalance <= 0)
          && (!('isSettled' in resource.data) || resource.data.isSettled == true);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0;

        match /payments/{paymentId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid);
        }
      }
    }
  }
}
