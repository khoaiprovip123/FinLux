rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isPositiveMoney(val) {
      return val is int && val > 0 && val <= 999999999999999;
    }

    function isNonNegativeMoney(val) {
      return val is int && val >= 0 && val <= 999999999999999;
    }

    function validTransaction(data) {
      return (data.type in ['EXPENSE', 'INCOME', 'TRANSFER_OUT', 'TRANSFER_IN', 'ADJUSTMENT', 'DEAL_OUTLAY', 'DEAL_INFLOW']
        || data.type in ['expense', 'income', 'transfer_out', 'transfer_in', 'adjustment'])
        && isPositiveMoney(data.amount)
        && (
          ('dealFlowType' in data && data.dealFlowType in ['CAPITAL_LOSS', 'capital_loss'])
          || (data.walletId is string && data.walletId.size() > 0)
        )
        && (
          data.type in ['TRANSFER_OUT', 'TRANSFER_IN', 'transfer_out', 'transfer_in']
          || ('dealId' in data && data.dealId != null && data.dealId != '')
          || ('dealFlowType' in data && data.dealFlowType != null)
          || (data.categoryId is string && data.categoryId.size() > 0)
        )
        && (!('relatedWalletId' in data) || data.relatedWalletId == null || (data.relatedWalletId is string && data.relatedWalletId != data.walletId))
        && (!('counterpartTransactionId' in data) || data.counterpartTransactionId == null || data.counterpartTransactionId is string)
        && (!('dealId' in data) || data.dealId == null || data.dealId is string)
        && (!('dealFlowType' in data) || data.dealFlowType == null || data.dealFlowType in [
          'OUTLAY_CAPITAL', 'PRINCIPAL_RECOVERY', 'CAPITAL_GAIN', 'CAPITAL_LOSS',
          'outlay_capital', 'principal_recovery', 'capital_gain', 'capital_loss',
          'OUTLAY', 'INFLOW'
        ])
        && data.date is timestamp;
    }

    function transactionDelta(data) {
      return ('dealFlowType' in data && data.dealFlowType in ['CAPITAL_LOSS', 'capital_loss']) ? 0
        : (data.type in ['INCOME', 'TRANSFER_IN', 'DEAL_INFLOW', 'income', 'transfer_in']) ? data.amount
        : (data.type in ['EXPENSE', 'TRANSFER_OUT', 'DEAL_OUTLAY', 'expense', 'transfer_out']) ? 0 - data.amount
        : 0;
    }

    function dealSplitMovesWallet(uid, data) {
      let otherDoc = getAfter(/databases/$(database)/documents/users/$(uid)/transactions/$(data.counterpartTransactionId));
      let combinedDelta = transactionDelta(data) + transactionDelta(otherDoc.data);
      return otherDoc.data.walletId == data.walletId
        && walletMovesBy(uid, data.walletId, combinedDelta);
    }

    function transactionWalletMovesOnCreate(uid, data) {
      return ('dealFlowType' in data && data.dealFlowType in ['CAPITAL_LOSS', 'capital_loss'])
        || (
          'counterpartTransactionId' in data && data.counterpartTransactionId != null
          && 'dealId' in data && data.dealId != null
          && existsAfter(/databases/$(database)/documents/users/$(uid)/transactions/$(data.counterpartTransactionId))
          && dealSplitMovesWallet(uid, data)
        )
        || (
          'walletId' in data && data.walletId is string && data.walletId.size() > 0
          && walletMovesBy(uid, data.walletId, transactionDelta(data))
        );
    }

    function walletMovesBy(uid, walletId, delta) {
      return delta == 0
        || (
          getAfter(/databases/$(database)/documents/users/$(uid)/wallets/$(walletId)).data.balance
          == get(/databases/$(database)/documents/users/$(uid)/wallets/$(walletId)).data.balance + delta
        );
    }

    function walletBalanceDelta(uid, walletId) {
      return getAfter(/databases/$(database)/documents/users/$(uid)/wallets/$(walletId)).data.balance
        - get(/databases/$(database)/documents/users/$(uid)/wallets/$(walletId)).data.balance;
    }

    function createdLedgerDelta(uid, data) {
      return ('counterpartTransactionId' in data && data.counterpartTransactionId != null
          && 'dealId' in data && data.dealId != null
          && ledgerCreated(uid, data.counterpartTransactionId))
        ? transactionDelta(data)
          + transactionDelta(getAfter(/databases/$(database)/documents/users/$(uid)/transactions/$(data.counterpartTransactionId)).data)
        : transactionDelta(data);
    }

    function walletHasLedgerTransition(uid, walletId, transactionId) {
      let beforeExists = exists(/databases/$(database)/documents/users/$(uid)/transactions/$(transactionId));
      let afterExists = existsAfter(/databases/$(database)/documents/users/$(uid)/transactions/$(transactionId));
      let before = beforeExists
        ? get(/databases/$(database)/documents/users/$(uid)/transactions/$(transactionId)).data
        : null;
      let after = afterExists
        ? getAfter(/databases/$(database)/documents/users/$(uid)/transactions/$(transactionId)).data
        : null;
      let balanceDelta = walletBalanceDelta(uid, walletId);
      return (!beforeExists && afterExists
          && after.walletId == walletId
          && balanceDelta == createdLedgerDelta(uid, after))
        || (beforeExists && afterExists && before != after
          && (
            (before.walletId == walletId && after.walletId == walletId
              && balanceDelta == transactionDelta(after) - transactionDelta(before))
            || (before.walletId == walletId && after.walletId != walletId
              && balanceDelta == 0 - transactionDelta(before))
            || (before.walletId != walletId && after.walletId == walletId
              && balanceDelta == transactionDelta(after))
          ))
        || (beforeExists && !afterExists
          && before.walletId == walletId
          && balanceDelta == 0 - transactionDelta(before));
    }

    function ledgerCreated(uid, transactionId) {
      return !exists(/databases/$(database)/documents/users/$(uid)/transactions/$(transactionId))
        && existsAfter(/databases/$(database)/documents/users/$(uid)/transactions/$(transactionId));
    }

    function ledgerDeleted(uid, transactionId) {
      return exists(/databases/$(database)/documents/users/$(uid)/transactions/$(transactionId))
        && !existsAfter(/databases/$(database)/documents/users/$(uid)/transactions/$(transactionId));
    }

    function goalLedgerTransitionIsValid(uid, goalId, before, after) {
      let transactionId = after.lastTransactionId;
      let ledger = getAfter(/databases/$(database)/documents/users/$(uid)/transactions/$(transactionId)).data;
      return ledgerCreated(uid, transactionId)
        && ledger.goalId == goalId
        && ledger.categoryId == 'savings'
        && after.savedAmount - before.savedAmount == 0 - transactionDelta(ledger);
    }

    function debtPaymentTransitionIsValid(uid, debtId, before, after) {
      let paymentId = after.lastPaymentId;
      let payment = getAfter(/databases/$(database)/documents/users/$(uid)/debts/$(debtId)/payments/$(paymentId)).data;
      let ledger = getAfter(/databases/$(database)/documents/users/$(uid)/transactions/$(payment.transactionId)).data;
      let beforePaymentCount = 'paymentCount' in before ? before.paymentCount : 0;
      return !exists(/databases/$(database)/documents/users/$(uid)/debts/$(debtId)/payments/$(paymentId))
        && existsAfter(/databases/$(database)/documents/users/$(uid)/debts/$(debtId)/payments/$(paymentId))
        && ledgerCreated(uid, payment.transactionId)
        && payment.debtId == debtId
        && payment.amount == payment.principalPaid + payment.interestPaid
        && payment.principalPaid <= before.remainingBalance
        && ledger.debtId == debtId
        && ledger.debtPaymentId == paymentId
        && ledger.walletId == payment.walletId
        && ledger.amount == payment.amount
        && after.remainingBalance == before.remainingBalance - payment.principalPaid
        && after.isSettled == (after.remainingBalance == 0)
        && after.paymentCount == beforePaymentCount + 1;
    }

    function dealGainAggregateIsValid(uid, dealId, before, after, ledger, direction) {
      return after.netProfitLoss == before.netProfitLoss + direction * ledger.amount
        && (
          (!('counterpartTransactionId' in ledger) || ledger.counterpartTransactionId == null)
            && after.totalRecovered == before.totalRecovered
          || (
            direction == 1
            && ledgerCreated(uid, ledger.counterpartTransactionId)
            && getAfter(/databases/$(database)/documents/users/$(uid)/transactions/$(ledger.counterpartTransactionId)).data.dealId == dealId
            && getAfter(/databases/$(database)/documents/users/$(uid)/transactions/$(ledger.counterpartTransactionId)).data.walletId == ledger.walletId
            && getAfter(/databases/$(database)/documents/users/$(uid)/transactions/$(ledger.counterpartTransactionId)).data.dealFlowType in ['PRINCIPAL_RECOVERY', 'principal_recovery']
            && after.totalRecovered == before.totalRecovered
              + getAfter(/databases/$(database)/documents/users/$(uid)/transactions/$(ledger.counterpartTransactionId)).data.amount
          )
        );
    }

    function dealLedgerTransitionIsValid(uid, dealId, before, after) {
      let transactionId = after.lastTransactionId;
      let created = ledgerCreated(uid, transactionId);
      let deleted = ledgerDeleted(uid, transactionId);
      let ledger = created
        ? getAfter(/databases/$(database)/documents/users/$(uid)/transactions/$(transactionId)).data
        : get(/databases/$(database)/documents/users/$(uid)/transactions/$(transactionId)).data;
      let direction = created ? 1 : -1;
      return (created || deleted)
        && ledger.dealId == dealId
        && (
          (ledger.dealFlowType in ['OUTLAY_CAPITAL', 'outlay_capital']
            && after.totalCapitalOutlay == before.totalCapitalOutlay + direction * ledger.amount
            && after.totalRecovered == before.totalRecovered
            && after.netProfitLoss == before.netProfitLoss)
          || (ledger.dealFlowType in ['PRINCIPAL_RECOVERY', 'principal_recovery']
            && after.totalRecovered == before.totalRecovered + direction * ledger.amount
            && after.totalCapitalOutlay == before.totalCapitalOutlay
            && after.netProfitLoss == before.netProfitLoss)
          || (ledger.dealFlowType in ['CAPITAL_GAIN', 'capital_gain']
            && after.totalCapitalOutlay == before.totalCapitalOutlay
            && dealGainAggregateIsValid(uid, dealId, before, after, ledger, direction))
          || (ledger.dealFlowType in ['CAPITAL_LOSS', 'capital_loss']
            && after.totalCapitalOutlay == before.totalCapitalOutlay
            && after.totalRecovered == before.totalRecovered
            && after.netProfitLoss == before.netProfitLoss - direction * ledger.amount)
        );
    }

    function validDeal(data) {
      return data.title is string && data.title.size() > 0
        && (!('description' in data) || data.description is string)
        && data.category in ['INVESTMENT', 'LENDING', 'investment', 'lending']
        && isNonNegativeMoney(data.targetAmount)
        && isNonNegativeMoney(data.totalCapitalOutlay)
        && isNonNegativeMoney(data.totalRecovered)
        && data.netProfitLoss is int
        && data.status in ['ACTIVE', 'COMPLETED', 'CANCELLED', 'active', 'completed', 'cancelled']
        && data.startDate is timestamp
        && (!('endDate' in data) || data.endDate == null || data.endDate is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validBudget(data) {
      return (
        data.keys().hasOnly([
          'categoryId', 'periodKey', 'periodStart', 'periodEndExclusive', 'periodBasis',
          'month', 'limitAmount', 'spentAmount', 'notified80', 'notified100'
        ])
        && data.categoryId is string && data.categoryId.size() > 0
        && isNonNegativeMoney(data.limitAmount)
        && (!('spentAmount' in data) || isNonNegativeMoney(data.spentAmount))
        && (!('notified80' in data) || data.notified80 is bool)
        && (!('notified100' in data) || data.notified100 is bool)
        && (
          (
            data.periodBasis == 'SALARY_CYCLE'
            && data.periodKey.matches('^salary:[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && data.periodStart is timestamp
            && data.periodEndExclusive is timestamp
            && data.periodEndExclusive > data.periodStart
            && (!('month' in data) || data.month == null)
          )
          || (
            data.periodBasis == 'CALENDAR_MONTH'
            && data.periodKey.matches('^month:[0-9]{4}-[0-9]{2}$')
            && data.periodStart is timestamp
            && data.periodEndExclusive is timestamp
            && data.periodEndExclusive > data.periodStart
            && (!('month' in data) || data.month == null || data.month is string)
          )
          || (
            (!('periodKey' in data) || data.periodKey == null)
            && (!('periodBasis' in data) || data.periodBasis == null)
            && 'month' in data && data.month is string && data.month.matches('^[0-9]{4}-[0-9]{2}$')
          )
        )
      );
    }

    function validSalaryCyclePreference(data) {
      return data.enabled is bool
        && data.paydayRuleType in ['DAY_OF_MONTH', 'LAST_DAY_OF_MONTH', 'FIRST_DAY_OF_MONTH']
        && data.paydayDay is int && data.paydayDay >= 1 && data.paydayDay <= 31
        && data.budgetPeriodBasis in ['SALARY_CYCLE', 'CALENDAR_MONTH']
        && data.financeTimeZone is string && data.financeTimeZone.size() > 0
        && data.rolloverRule in ['ASK_EACH_CYCLE', 'MOVE_TO_SAVINGS', 'KEEP_IN_WALLET']
        && (!('salaryWalletId' in data) || data.salaryWalletId == null || data.salaryWalletId is string)
        && (!('savingsWalletId' in data) || data.savingsWalletId == null || data.savingsWalletId is string)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function validSavingSpinConfig(data) {
      return data.keys().hasOnly([
          'enabled', 'showOnHome', 'minAmount', 'maxAmount', 'stepAmount',
          'slotCount', 'frequency', 'selectedWeekdays', 'weeklyDay',
          'reminderEnabled', 'reminderHour', 'reminderMinute', 'snoozeEnabled',
          'allowSkip', 'defaultDestinationId', 'createdAt', 'updatedAt'
        ])
        && data.enabled is bool
        && data.showOnHome is bool
        && isPositiveMoney(data.minAmount)
        && isPositiveMoney(data.maxAmount)
        && data.maxAmount >= data.minAmount
        && data.maxAmount <= 999999999999999
        && data.stepAmount in [5000, 10000]
        && data.minAmount % data.stepAmount == 0
        && data.maxAmount % data.stepAmount == 0
        && data.slotCount in [6, 8, 10, 12]
        && data.frequency in ['DAILY', 'SELECTED_WEEKDAYS', 'WEEKLY', 'SALARY_CYCLE']
        && data.selectedWeekdays is list
        && data.weeklyDay is int && data.weeklyDay >= 1 && data.weeklyDay <= 7
        && data.reminderEnabled is bool
        && data.reminderHour is int && data.reminderHour >= 0 && data.reminderHour <= 23
        && data.reminderMinute is int && data.reminderMinute >= 0 && data.reminderMinute <= 59
        && data.snoozeEnabled is bool
        && data.allowSkip is bool
        && (data.defaultDestinationId == null || data.defaultDestinationId is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validSavingDestination(data) {
      return data.keys().hasOnly([
          'name', 'method', 'linkedWalletId', 'institutionId', 'accountHint',
          'enabled', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.method in ['CASH', 'BANK_TRANSFER']
        && (data.linkedWalletId == null || data.linkedWalletId is string)
        && (data.institutionId == null || data.institutionId is string)
        && (data.accountHint == null || (data.accountHint is string && data.accountHint.size() <= 40))
        && data.enabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validSavingSpinSession(data) {
      return data.keys().hasOnly([
          'scheduleKey', 'wheelValues', 'selectedIndex', 'selectedAmount', 'status',
          'destinationId', 'method', 'spunAt', 'completedAt', 'skippedAt',
          'snoozedUntil', 'createdAt', 'updatedAt'
        ])
        && data.scheduleKey is string && data.scheduleKey.size() > 0
        && data.wheelValues is list && data.wheelValues.size() in [6, 8, 10, 12]
        && (data.selectedIndex == null || data.selectedIndex is int)
        && (data.selectedAmount == null || isPositiveMoney(data.selectedAmount))
        && data.status in ['READY', 'SPUN_PENDING', 'COMPLETED', 'SNOOZED', 'SKIPPED']
        && (data.destinationId == null || data.destinationId is string)
        && (data.method == null || data.method in ['CASH', 'BANK_TRANSFER'])
        && (data.spunAt == null || data.spunAt is timestamp)
        && (data.completedAt == null || data.completedAt is timestamp)
        && (data.skippedAt == null || data.skippedAt is timestamp)
        && (data.snoozedUntil == null || data.snoozedUntil is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validSavingSpinTransition(before, after) {
      return before.status == after.status
        || (before.status == 'READY' && after.status in ['SPUN_PENDING', 'SKIPPED'])
        || (before.status == 'SNOOZED' && after.status in ['SPUN_PENDING', 'COMPLETED', 'SNOOZED', 'SKIPPED'])
        || (before.status == 'SPUN_PENDING' && after.status in ['COMPLETED', 'SNOOZED', 'SKIPPED']);
    }

    // Root user profile document
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);

      // Subcollection: Transactions
      match /transactions/{docId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validTransaction(request.resource.data)
          && transactionWalletMovesOnCreate(uid, request.resource.data);
        allow update: if isOwner(uid)
          && validTransaction(request.resource.data)
          && (
            (
              'dealFlowType' in resource.data && resource.data.dealFlowType in ['CAPITAL_LOSS', 'capital_loss']
              && 'dealFlowType' in request.resource.data && request.resource.data.dealFlowType in ['CAPITAL_LOSS', 'capital_loss']
            )
            || (
              resource.data.walletId == request.resource.data.walletId
              && walletMovesBy(
                uid,
                request.resource.data.walletId,
                transactionDelta(request.resource.data) - transactionDelta(resource.data)
              )
            )
            || (
              resource.data.walletId != request.resource.data.walletId
              && walletMovesBy(uid, resource.data.walletId, 0 - transactionDelta(resource.data))
              && walletMovesBy(
                uid,
                request.resource.data.walletId,
                transactionDelta(request.resource.data)
              )
            )
          );
        allow delete: if isOwner(uid)
          && (
            ('dealFlowType' in resource.data && resource.data.dealFlowType in ['CAPITAL_LOSS', 'capital_loss'])
            || (!('walletId' in resource.data) || resource.data.walletId == null || resource.data.walletId == '' || resource.data.walletId == 'DEAL_SETTLEMENT')
            || walletMovesBy(uid, resource.data.walletId, 0 - transactionDelta(resource.data))
          );
      }

      // Subcollection: Wallets
      match /wallets/{docId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'name', 'type', 'balance', 'color', 'isDefault', 'createdAt', 'status', 'archivedAt', 'lastTransactionId'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.balance is int
          && request.resource.data.type in ['cash', 'bank', 'ewallet', 'card', 'investment', 'other']
          && (!('status' in request.resource.data) || request.resource.data.status in ['active', 'archived'])
          && (!('archivedAt' in request.resource.data) || request.resource.data.archivedAt is timestamp);

        allow update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'name', 'type', 'balance', 'color', 'isDefault', 'createdAt', 'status', 'archivedAt', 'lastTransactionId'
          ])
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() > 0))
          && (!('balance' in request.resource.data) || request.resource.data.balance is int)
          && (!('type' in request.resource.data) || request.resource.data.type in ['cash', 'bank', 'ewallet', 'card', 'investment', 'other'])
          && (!('status' in request.resource.data) || request.resource.data.status in ['active', 'archived'])
          && (!('archivedAt' in request.resource.data) || request.resource.data.archivedAt is timestamp)
          && (
            (
              request.resource.data.balance == resource.data.balance
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'name', 'type', 'color', 'isDefault', 'status', 'archivedAt'
              ])
            )
            || (
              request.resource.data.balance != resource.data.balance
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'balance', 'lastTransactionId'
              ])
              && 'lastTransactionId' in request.resource.data
              && request.resource.data.lastTransactionId is string
              && request.resource.data.lastTransactionId.size() > 0
              && walletHasLedgerTransition(
                uid,
                docId,
                request.resource.data.lastTransactionId
              )
            )
          );
      }

      // Subcollection: Budgets
      match /budgets/{docId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && validBudget(request.resource.data)
          && (!('spentAmount' in request.resource.data) || request.resource.data.spentAmount == 0)
          && (!('notified80' in request.resource.data) || request.resource.data.notified80 == false)
          && (!('notified100' in request.resource.data) || request.resource.data.notified100 == false);
        allow update: if isOwner(uid)
          && validBudget(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['limitAmount']);
      }

      // Subcollection: Categories
      match /categories/{docId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0;
      }

      // Subcollection: Financial Goals
      match /goals/{docId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid)
          && (!('savedAmount' in resource.data) || resource.data.savedAmount == 0);
        allow create: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && (!('savedAmount' in request.resource.data) || request.resource.data.savedAmount == 0)
          && (!('targetAmount' in request.resource.data) || (request.resource.data.targetAmount is int && request.resource.data.targetAmount >= 0));
        allow update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.savedAmount is int
          && request.resource.data.savedAmount >= 0
          && request.resource.data.targetAmount is int
          && request.resource.data.targetAmount >= 0
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'targetAmount', 'deadline', 'category', 'monthlyContribution', 'imageUri', 'createdAt'
            ])
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['savedAmount', 'lastTransactionId'])
              && request.resource.data.lastTransactionId is string
              && goalLedgerTransitionIsValid(uid, docId, resource.data, request.resource.data)
            )
          );
      }

      // Subcollection: Reminders
      match /reminders/{docId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.categoryId is string
          && request.resource.data.walletId is string;
      }

      // Subcollection: Notifications
      match /notifications/{docId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.title is string;
      }

      // User financial preferences
      match /financialPreferences/{preferenceId} {
        allow read: if isOwner(uid) && preferenceId == 'salaryCycle';
        allow create, update: if isOwner(uid)
          && preferenceId == 'salaryCycle'
          && validSalaryCyclePreference(request.resource.data);
        allow delete: if isOwner(uid) && preferenceId == 'salaryCycle';
      }

      // Subcollection: Salary Rollovers
      match /salaryRollovers/{docId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['cycleKey', 'processedAt'])
          && request.resource.data.cycleKey is string
          && request.resource.data.processedAt is timestamp;
        allow update: if false;
        allow delete: if false;
      }

      match /savingSpinConfigs/{configId} {
        allow read: if isOwner(uid) && configId == 'default';
        allow create, update: if isOwner(uid)
          && configId == 'default'
          && validSavingSpinConfig(request.resource.data);
        allow delete: if isOwner(uid) && configId == 'default';
      }

      match /savingSpinDestinations/{destinationId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validSavingDestination(request.resource.data)
          && (!('accountHint' in request.resource.data)
            || request.resource.data.accountHint == null
            || !request.resource.data.accountHint.matches('.*[0-9]{7,}.*'));
      }

      match /savingSpinSessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validSavingSpinSession(request.resource.data)
          && request.resource.data.status == 'READY'
          && request.resource.data.selectedIndex == null
          && request.resource.data.selectedAmount == null;
        allow update: if isOwner(uid)
          && validSavingSpinSession(request.resource.data)
          && request.resource.data.scheduleKey == resource.data.scheduleKey
          && request.resource.data.wheelValues == resource.data.wheelValues
          && request.resource.data.createdAt == resource.data.createdAt
          && validSavingSpinTransition(resource.data, request.resource.data)
          && (resource.data.selectedAmount == null
            || (request.resource.data.selectedAmount == resource.data.selectedAmount
              && request.resource.data.selectedIndex == resource.data.selectedIndex));
        allow delete: if false;
      }

      // Subcollection: Debts & Debt Payments
      match /debts/{docId} {
        allow read: if isOwner(uid);
        allow delete: if false;
        allow create: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && (!('totalAmount' in request.resource.data) || (request.resource.data.totalAmount is int && request.resource.data.totalAmount >= 0))
          && (!('remainingBalance' in request.resource.data) || (request.resource.data.remainingBalance is int && request.resource.data.remainingBalance >= 0))
          && request.resource.data.paymentCount == 0;
        allow update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.totalAmount is int && request.resource.data.totalAmount >= 0
          && request.resource.data.remainingBalance is int && request.resource.data.remainingBalance >= 0
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'type', 'totalAmount', 'interestRateApr', 'minimumPayment', 'dueDate',
              'statementDate', 'colorHex', 'isReminderEnabled', 'reminderDaysBefore', 'updatedAt'
            ])
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'remainingBalance', 'isSettled', 'updatedAt', 'lastPaymentId', 'paymentCount'
              ])
              && request.resource.data.lastPaymentId is string
              && debtPaymentTransitionIsValid(uid, docId, resource.data, request.resource.data)
            )
          );

        match /payments/{paymentId} {
          allow read: if isOwner(uid);
          allow update, delete: if false;
          allow create: if isOwner(uid)
            && request.resource.data.amount is int && request.resource.data.amount > 0
            && request.resource.data.principalPaid is int && request.resource.data.principalPaid >= 0
            && request.resource.data.interestPaid is int && request.resource.data.interestPaid >= 0
            && request.resource.data.amount == request.resource.data.principalPaid + request.resource.data.interestPaid
            && request.resource.data.transactionId is string
            && getAfter(/databases/$(database)/documents/users/$(uid)/debts/$(docId)).data.lastPaymentId == paymentId;
        }
      }

      // Subcollection: Deals
      match /deals/{docId} {
        allow read: if isOwner(uid);
        allow delete: if false;
        allow create: if isOwner(uid)
          && validDeal(request.resource.data)
          && request.resource.data.totalCapitalOutlay == 0
          && request.resource.data.totalRecovered == 0
          && request.resource.data.netProfitLoss == 0
          && request.resource.data.status in ['ACTIVE', 'active'];
        allow update: if isOwner(uid)
          && validDeal(request.resource.data)
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title', 'description', 'category', 'targetAmount', 'startDate', 'status', 'endDate', 'updatedAt'
            ])
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'totalCapitalOutlay', 'totalRecovered', 'netProfitLoss', 'status', 'endDate',
                'updatedAt', 'lastTransactionId'
              ])
              && request.resource.data.lastTransactionId is string
              && dealLedgerTransitionIsValid(uid, docId, resource.data, request.resource.data)
            )
          );
      }
    }
  }
}
